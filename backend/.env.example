PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
LOG_LEVEL=info
LOG_REQUESTS=true
XIAOXIAI_DB_PATH=

# Extra blocked words for chat content safety (comma-separated), appended to the built-in list.
EXTRA_BLOCKED_WORDS=

# Max long-term memories kept per user. Beyond this, the lowest-priority
# (least reinforced, oldest) facts are evicted. Invalid/missing falls back to 20.
MEMORY_CAP=20

# Long-term memory expiry in days. 0 (default) disables time-based pruning;
# when > 0, stale low-weight (never-reinforced) memories older than N days are pruned.
MEMORY_TTL_DAYS=0

# Baseline added to the real online count shown to users (0 = show only real online users).
PRESENCE_BASELINE=0

# Secret used to sign/verify simulated payment-gateway callbacks (HMAC-SHA256).
# MUST be overridden in production.
PAYMENT_SECRET=

# Secret used to sign account auth tokens (HMAC-SHA256). MUST be overridden in production.
AUTH_SECRET=

# Operator admin API + /admin.html token. Leave empty to fully disable the admin surface.
ADMIN_TOKEN=

# Leave OPENAI_API_KEY empty to use the local fallback dialog engine.
OPENAI_API_KEY=

# Examples:
# https://api.openai.com/v1
# https://api.deepseek.com/v1
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Examples:
# gpt-4o-mini
# deepseek-chat
OPENAI_MODEL_NAME=gpt-4o-mini

# --- Web search (联网搜索) via Bocha (博查) ---
# Leave BOCHA_API_KEY empty to disable web search entirely (model stays offline).
# When set, the chat model can call a `web_search` tool on demand for real-time /
# factual questions (weather, news, prices, recent events, etc.).
# Get a key at https://open.bochaai.com/
BOCHA_API_KEY=
# Endpoint override (defaults to the public Bocha Web Search API).
BOCHA_API_BASE_URL=https://api.bochaai.com/v1/web-search
# Number of results fed back to the model per search (1-10, default 5).
BOCHA_RESULT_COUNT=5
# Per-search HTTP timeout in ms (default 6000).
BOCHA_TIMEOUT_MS=6000
