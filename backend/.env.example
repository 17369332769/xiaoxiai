PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
LOG_LEVEL=info
LOG_REQUESTS=true
XIAOXIAI_DB_PATH=

# Extra blocked words for chat content safety (comma-separated), appended to the built-in list.
EXTRA_BLOCKED_WORDS=

# Baseline added to the real online count shown to users (0 = show only real online users).
PRESENCE_BASELINE=0

# Secret used to sign/verify simulated payment-gateway callbacks (HMAC-SHA256).
# MUST be overridden in production.
PAYMENT_SECRET=

# Secret used to sign account auth tokens (HMAC-SHA256). MUST be overridden in production.
AUTH_SECRET=

# Operator admin API + /admin.html token. Leave empty to fully disable the admin surface.
ADMIN_TOKEN=

# Leave OPENAI_API_KEY empty to use the local fallback dialog engine.
OPENAI_API_KEY=

# Examples:
# https://api.openai.com/v1
# https://api.deepseek.com/v1
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Examples:
# gpt-4o-mini
# deepseek-chat
OPENAI_MODEL_NAME=gpt-4o-mini
