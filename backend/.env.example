PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Express "trust proxy" setting — controls how req.ip is derived from
# X-Forwarded-For. Default 'loopback' fits a local Nginx that proxies to
# 127.0.0.1 (and is harmless for direct dev connections). Set to a hop count
# (e.g. 1) for an upstream load balancer. Do NOT use 'true' unless the edge
# strips client-supplied X-Forwarded-For — otherwise clients can spoof their IP
# and bypass the per-IP rate limiter / login throttle.
TRUST_PROXY=loopback
LOG_LEVEL=info
LOG_REQUESTS=true
XIAOXIAI_DB_PATH=

# Extra blocked words for chat content safety (comma-separated), appended to the built-in list.
EXTRA_BLOCKED_WORDS=

# Max long-term memories kept per user. Beyond this, the lowest-priority
# (least reinforced, oldest) facts are evicted. Invalid/missing falls back to 20.
MEMORY_CAP=20

# Long-term memory expiry in days. 0 (default) disables time-based pruning;
# when > 0, stale low-weight (never-reinforced) memories older than N days are pruned.
MEMORY_TTL_DAYS=0

# Max chat messages kept per user (default 300). Older messages are pruned after
# each reply so chat_messages can't grow without bound. Sync shows the last 40.
CHAT_HISTORY_CAP=300

# Baseline added to the real online count shown to users (0 = show only real online users).
PRESENCE_BASELINE=0

# Secret used to sign/verify simulated payment-gateway callbacks (HMAC-SHA256).
# MUST be overridden in production.
PAYMENT_SECRET=

# Secret used to sign account auth tokens (HMAC-SHA256). MUST be overridden in production.
AUTH_SECRET=

# Account auth token lifetime in days (default 30). Tokens past their exp are
# rejected; the client then falls back to guest and prompts re-login.
# Server-side revocation: POST /api/auth/logout bumps the account's token_version
# so every outstanding token stops resolving; POST /api/auth/refresh rotates a
# still-valid token's expiry without revoking other sessions.
AUTH_TOKEN_TTL_DAYS=30

# Login brute-force throttle, second tier (A2b): locks an identifier across ALL
# IPs so IP rotation can't sidestep the per-identifier+IP lock. Defaults shown.
LOGIN_THROTTLE_IDENTIFIER_MAX_FAILED=10
LOGIN_THROTTLE_IDENTIFIER_WINDOW_MS=3600000
LOGIN_THROTTLE_IDENTIFIER_LOCK_MS=600000

# Automatic SQLite backups via "VACUUM INTO" (atomic, WAL-safe). Set INTERVAL_MS
# or KEEP to 0 to disable. Backups are timestamped files in DB_BACKUP_DIR; only
# the newest DB_BACKUP_KEEP are retained.
DB_BACKUP_INTERVAL_MS=86400000
DB_BACKUP_KEEP=5
DB_BACKUP_DIR=

# Operator admin API + /admin.html token. Leave empty to fully disable the admin surface.
ADMIN_TOKEN=

# DEMO ONLY. When true, /api/action/tip instantly grants coins without a real
# payment, and /api/order/create returns a pre-signed gateway callback the client
# can replay to self-settle. Both are coin mints — NEVER enable in production;
# leave unset/false so coins are only granted via a real signed payment callback.
ALLOW_SIMULATED_PAYMENT=false

# Leave OPENAI_API_KEY empty to use the local fallback dialog engine.
OPENAI_API_KEY=

# Examples:
# https://api.openai.com/v1
# https://api.deepseek.com/v1
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Examples:
# gpt-4o-mini
# deepseek-chat
OPENAI_MODEL_NAME=gpt-4o-mini

# --- Web search (联网搜索) via Bocha (博查) ---
# Leave BOCHA_API_KEY empty to disable web search entirely (model stays offline).
# When set, the chat model can call a `web_search` tool on demand for real-time /
# factual questions (weather, news, prices, recent events, etc.).
# Get a key at https://open.bochaai.com/
BOCHA_API_KEY=
# Endpoint override (defaults to the public Bocha Web Search API).
BOCHA_API_BASE_URL=https://api.bochaai.com/v1/web-search
# Number of results fed back to the model per search (1-10, default 5).
BOCHA_RESULT_COUNT=5
# Per-search HTTP timeout in ms (default 6000).
BOCHA_TIMEOUT_MS=6000

# --- Text-to-speech (语音) via MiniMax 海螺 T2A v2 ---
# On-demand voice for chat replies (POST /api/tts). The synchronous endpoint
# returns inline audio in ~1s; the server hex-decodes it into a base64 data: URI.
# Only MINIMAX_API_KEY is required — the rest have sensible defaults.
#   MINIMAX_API_KEY            account key (Authorization: Bearer), from platform.minimaxi.com
#   MINIMAX_TTS_HOST           API host (default https://api.minimaxi.com)
#   MINIMAX_TTS_MODEL          speech-02-turbo (fast) | speech-2.6-hd | speech-2.8-hd | ...
#   MINIMAX_TTS_VOICE_ID       system voice OR a cloned voice id
#                              (default female-tianmei; clone one via scripts/minimax-clone-voice.mjs)
#   MINIMAX_TTS_SPEED          0.5–2 (default 1)
#   MINIMAX_TTS_VOL            >0–10 (default 1)
#   MINIMAX_TTS_PITCH          -12–12 (default 0)
#   MINIMAX_TTS_EMOTION        happy|sad|angry|fearful|disgusted|surprised|neutral (optional)
#   MINIMAX_TTS_FORMAT         mp3 | wav | pcm | flac (default mp3)
#   MINIMAX_TTS_SAMPLE_RATE    default 32000
#   MINIMAX_TTS_BITRATE        default 128000
#   MINIMAX_TTS_LANGUAGE_BOOST language hint (default Chinese)
MINIMAX_API_KEY=
MINIMAX_TTS_HOST=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-02-turbo
MINIMAX_TTS_VOICE_ID=female-tianmei
MINIMAX_TTS_FORMAT=mp3
MINIMAX_TTS_LANGUAGE_BOOST=Chinese

# --- 注册验证码 (OTP) 与密码找回 ---
# REQUIRE_REGISTRATION_OTP  注册是否强制校验验证码，默认 false（关闭，注册流程不变）
# OTP_DEV_ECHO              开发调试：把验证码回显在 request-code 响应里，默认 false（生产务必关闭）
# OTP_TTL_SECONDS           验证码有效期秒数，默认 600（10 分钟）
# OTP_RESEND_COOLDOWN_SECONDS  同一账号重复请求验证码的冷却秒数，默认 60
# 说明：验证码发送目前为「服务端日志输出」的开发桩；接入真实短信/邮件请在 backend/verification.js 的 sendVerificationCode 中实现。
REQUIRE_REGISTRATION_OTP=false
OTP_DEV_ECHO=false
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60

# --- 主动召回（回归问候）---
# RECALL_MIN_AWAY_HOURS  用户离开多少小时后再回来才触发“想你了”问候，默认 6
RECALL_MIN_AWAY_HOURS=6
