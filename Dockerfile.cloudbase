FROM node:22-slim

ENV NODE_ENV=production

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY backend/package.json backend/package-lock.json ./backend/
RUN cd backend && npm ci --omit=dev

COPY backend ./backend
COPY shared ./shared

WORKDIR /app/backend

ENV PORT=80
ENV XIAOXIAI_DB_PATH=/tmp/xiaoxiai.sqlite
ENV DB_BACKUP_DIR=/tmp/backups
ENV TRUST_PROXY=1
ENV ALLOW_SIMULATED_PAYMENT=false

EXPOSE 80

CMD ["node", "server.js"]
